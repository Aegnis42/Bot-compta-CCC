# --- Discord ---
# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# (optionnel) Catégorie dans laquelle créer les salons des charbonniers
CHARBONNIER_CATEGORY_ID=
# (optionnel) Rôle staff qui voit tous les salons charbonniers et peut déclarer pour les autres
STAFF_ROLE_ID=
# (optionnel) IDs de comptes Discord ayant accès à toutes les commandes, séparés par des virgules
# (1222839727934279692 est déjà autorisé par défaut)
ADMIN_IDS=
# (optionnel) Salon staff où poster le récap des salaires, en même temps que les avis de paie (dimanche 17h)
RECAP_CHANNEL_ID=

# --- Google Sheets ---
# URL de l'application Web Apps Script (voir apps-script/Code.gs)
APPS_SCRIPT_URL=
# Même valeur que SECRET dans le script
APPS_SCRIPT_SECRET=

# --- Divers ---
# Fréquence (secondes) à laquelle le bot regarde le Google Sheet pour les saisies manuelles
SYNC_INTERVAL_SECONDS=30
TIMEZONE=Europe/Paris
