# --- Discord ---
# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID du serveur Discord
DISCORD_GUILD_ID=1555109924265005087
# (optionnel) Catégorie dans laquelle créer les salons des charbonniers
CHARBONNIER_CATEGORY_ID=
# (optionnel) Rôle staff qui voit tous les salons charbonniers et peut déclarer pour les autres
STAFF_ROLE_ID=
# (optionnel) Salon où le bot poste le récap des salaires chaque lundi à 00h
RECAP_CHANNEL_ID=

# --- Google Sheets ---
SPREADSHEET_ID=1ojju2xdH6aWTYVFs0txph029TodFCJ_gjEb_906_Qlg
# Chemin vers le fichier JSON du compte de service Google
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# OU le contenu JSON directement (pratique sur un hébergeur) — prioritaire si rempli
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Divers ---
# Fréquence (secondes) à laquelle le bot regarde le Google Sheet pour les saisies manuelles
SYNC_INTERVAL_SECONDS=30
TIMEZONE=Europe/Paris
